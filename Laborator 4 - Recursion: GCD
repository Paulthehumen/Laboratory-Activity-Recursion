package gdcrecursion;

import java.util.Scanner;

public class GdcRecursion {

  
    static int gcd(int a, int b) {
      
        if (b == 0) {
            System.out.println("gcd(" + a + ", " + b + ")  -> base case reached, returns " + a);
            return a;
        }   
        System.out.println("gcd(" + a + ", " + b + ")  a % b = " + (a % b)
                + "  -> next call: gcd(" + b + ", " + (a % b) + ")");

        int result = gcd(b, a % b);
        System.out.println("gcd(" + a + ", " + b + ")  returns " + result);
        return result;
    }

public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.print("Enter first non-negative integer (a): ");
        int a = input.nextInt();
        System.out.print("Enter second non-negative integer (b): ");
        int b = input.nextInt();

        if (a < 0 || b < 0 || (a == 0 && b == 0)) {
            System.out.println("Invalid input: numbers must be non-negative and not both zero.");
            return;
        }
        System.out.println("Recursion trace");
        int answer = gcd(a, b);

        System.out.println("\nThe GCD of " + a + " and " + b + " is " + answer);
    }
}
